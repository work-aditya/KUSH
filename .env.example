# ============================================================
# COACHKUSH - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and populate with production values.
# NEVER commit the actual .env file to source control.
# ============================================================

# ==============================
# APPLICATION
# ==============================
NODE_ENV=production
PORT=5000

# ==============================
# URLS
# ==============================
FRONTEND_URL=https://yourdomain.com
VITE_API_URL=https://api.yourdomain.com

# ==============================
# DATABASE
# ==============================
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/coachkush

# ==============================
# AUTH
# ==============================
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=1d

# ==============================
# ADMIN
# ==============================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_VERY_SECURE_ADMIN_PASSWORD

# ==============================
# WHATSAPP
# ==============================
WHATSAPP_CONTACT_URL=https://wa.me/91XXXXXXXXXX

# ==============================
# EMAIL (SMTP)
# ==============================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=CHANGE_THIS
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=CoachKush

# ==============================
# PHONEPE PAYMENT GATEWAY (STANDARD CHECKOUT V2)
# ==============================
PHONEPE_ENVIRONMENT=PRODUCTION
PHONEPE_CLIENT_ID=YOUR_PHONEPE_CLIENT_ID
PHONEPE_CLIENT_SECRET=YOUR_PHONEPE_CLIENT_SECRET
PHONEPE_CLIENT_VERSION=1
PHONEPE_MERCHANT_ID=YOUR_MERCHANT_ID
PHONEPE_CALLBACK_URL=https://yourdomain.com/api/payments/webhook
